From 76c9427a60de0f1292d939efb0b4470a1526b5ed Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Sat, 7 Nov 2026 12:33:34 +0100
Subject: [PATCH] battery: the kernel powers off below 3.35 V, under the
 firmware's cut

low_bat_net_work reads the gauge's voltage and current every 10 s and
powers off through battery_power_off, which syncs first, once the last
6 readings average under LOW_TMP_BAT_VOLTAGE_LOW_BOUND (3350 mV) while
discharging; a suspend empties the window. The firmware cuts at a
10-sample mean under 3400 mV, so this cut comes only where the firmware
does not run.
---
 drivers/power/supply/mtk_battery.c | 62 ++++++++++++++++++++++++++++++
 drivers/power/supply/mtk_battery.h | 10 +++++
 2 files changed, 72 insertions(+)

diff --git a/drivers/power/supply/mtk_battery.c b/drivers/power/supply/mtk_battery.c
index f945cc7b7..d11b3068f 100755
--- a/drivers/power/supply/mtk_battery.c
+++ b/drivers/power/supply/mtk_battery.c
@@ -22,6 +22,7 @@
 #include <linux/sched.h>	/* For wait queue*/
 #include <linux/skbuff.h>	/* netlink */
 #include <linux/socket.h>	/* netlink */
+#include <linux/suspend.h>	/* register_pm_notifier */
 #include <linux/syscalls.h>	/* ksys_sync */
 #include <linux/time.h>
 #include <linux/vmalloc.h>
@@ -2871,6 +2872,61 @@ static int power_misc_routine_thread(void *arg)
 	return 0;
 }
 
+static void low_bat_net_work(struct work_struct *work)
+{
+	struct shutdown_controller *sdc = container_of(to_delayed_work(work),
+		struct shutdown_controller, net_work);
+	int vbat = 0, ibat = 0, i, vbat_sum = 0, ibat_sum = 0;
+	bool read, low = false;
+
+	read = gauge_get_property(GAUGE_PROP_BATTERY_VOLTAGE, &vbat) >= 0 &&
+		gauge_get_property(GAUGE_PROP_BATTERY_CURRENT, &ibat) >= 0;
+	mutex_lock(&sdc->lock);
+	if (read) {
+		sdc->net_vbat[sdc->net_idx] = vbat;
+		sdc->net_ibat[sdc->net_idx] = ibat;
+		sdc->net_idx = (sdc->net_idx + 1) % LOW_BAT_NET_SAMPLES;
+		if (sdc->net_count < LOW_BAT_NET_SAMPLES)
+			sdc->net_count++;
+	}
+	if (sdc->net_count == LOW_BAT_NET_SAMPLES) {
+		for (i = 0; i < LOW_BAT_NET_SAMPLES; i++) {
+			vbat_sum += sdc->net_vbat[i];
+			ibat_sum += sdc->net_ibat[i];
+		}
+		low = vbat_sum < LOW_BAT_NET_MV * LOW_BAT_NET_SAMPLES &&
+			ibat_sum < 0;
+	}
+	mutex_unlock(&sdc->lock);
+
+	if (low) {
+		pr_crit("battery: a mean of %d mV over %d s while discharging, under %d mV: powering off\n",
+			vbat_sum / LOW_BAT_NET_SAMPLES,
+			LOW_BAT_NET_SAMPLES * LOW_BAT_NET_PERIOD_SEC,
+			LOW_BAT_NET_MV);
+		battery_power_off();
+	}
+
+	queue_delayed_work(system_freezable_power_efficient_wq,
+		&sdc->net_work, LOW_BAT_NET_PERIOD_SEC * HZ);
+}
+
+static int low_bat_net_pm_event(struct notifier_block *nb,
+	unsigned long event, void *unused)
+{
+	struct shutdown_controller *sdc =
+		container_of(nb, struct shutdown_controller, pm_nb);
+
+	/* a sleep ends the window: after it the readings start anew */
+	if (event == PM_SUSPEND_PREPARE) {
+		mutex_lock(&sdc->lock);
+		sdc->net_count = 0;
+		mutex_unlock(&sdc->lock);
+	}
+
+	return NOTIFY_DONE;
+}
+
 static int mtk_power_misc_psy_event(
 	struct notifier_block *nb, unsigned long event, void *v)
 {
@@ -2909,6 +2965,12 @@ void mtk_power_misc_init(struct mtk_battery *gm)
 
 	gm->sdc.psy_nb.notifier_call = mtk_power_misc_psy_event;
 	power_supply_reg_notifier(&gm->sdc.psy_nb);
+
+	INIT_DELAYED_WORK(&gm->sdc.net_work, low_bat_net_work);
+	gm->sdc.pm_nb.notifier_call = low_bat_net_pm_event;
+	register_pm_notifier(&gm->sdc.pm_nb);
+	queue_delayed_work(system_freezable_power_efficient_wq,
+		&gm->sdc.net_work, LOW_BAT_NET_PERIOD_SEC * HZ);
 }
 
 int battery_psy_init(struct platform_device *pdev)
diff --git a/drivers/power/supply/mtk_battery.h b/drivers/power/supply/mtk_battery.h
index 465159b71..4909e4572 100644
--- a/drivers/power/supply/mtk_battery.h
+++ b/drivers/power/supply/mtk_battery.h
@@ -734,6 +734,10 @@ struct simulator_log {
 #define AVGVBAT_ARRAY_SIZE 30
 #define INIT_VOLTAGE 3450
 #define BATTERY_SHUTDOWN_TEMPERATURE 60
+/* low_bat_net_work: the last 6 readings, 10 s apart, against the stock cold-cell bound, under the firmware's 3400 mV */
+#define LOW_BAT_NET_PERIOD_SEC 10
+#define LOW_BAT_NET_SAMPLES 6
+#define LOW_BAT_NET_MV LOW_TMP_BAT_VOLTAGE_LOW_BOUND
 
 struct shutdown_condition {
 	bool is_overheat;
@@ -759,6 +763,12 @@ struct shutdown_controller {
 	int vbat_lt;
 	int vbat_lt_lv1;
 	int shutdown_cond_flag;
+	struct delayed_work net_work;
+	struct notifier_block pm_nb;
+	int net_vbat[LOW_BAT_NET_SAMPLES];
+	int net_ibat[LOW_BAT_NET_SAMPLES];
+	int net_idx;
+	int net_count;
 };
 
 struct BAT_EC_Struct {
-- 
2.56.0

