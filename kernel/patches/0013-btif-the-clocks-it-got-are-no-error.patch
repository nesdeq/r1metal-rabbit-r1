From fe21f70a1e2331a063697925ced0056b2c6c5315 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 10:36:04 +0200
Subject: [PATCH] btif: the clocks it got are no error

The two clock handles hal_btif_clk_get_and_prepare() got print as info,
"[I]": they report a success, which BTIF_ERR_FUNC labels "[E]".
---
 drivers/misc/mediatek/btif/common/btif_plat.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/misc/mediatek/btif/common/btif_plat.c b/drivers/misc/mediatek/btif/common/btif_plat.c
index dd586f9c8..1b7d6d799 100644
--- a/drivers/misc/mediatek/btif/common/btif_plat.c
+++ b/drivers/misc/mediatek/btif/common/btif_plat.c
@@ -289,13 +289,13 @@ int hal_btif_clk_get_and_prepare(struct platform_device *pdev)
 			BTIF_ERR_FUNC("[CCF]cannot get clk_btif clock.\n");
 			return PTR_ERR(clk_btif);
 		}
-		BTIF_ERR_FUNC("[CCF]clk_btif=%p\n", clk_btif);
+		BTIF_INFO_FUNC("[CCF]clk_btif=%p\n", clk_btif);
 		clk_btif_apdma = devm_clk_get(&pdev->dev, "apdmac");
 		if (IS_ERR(clk_btif_apdma)) {
 			BTIF_ERR_FUNC("[CCF]can't get clk_btif_apdma clock.\n");
 			return PTR_ERR(clk_btif_apdma);
 		}
-		BTIF_ERR_FUNC("[CCF]clk_btif_apdma=%p\n", clk_btif_apdma);
+		BTIF_INFO_FUNC("[CCF]clk_btif_apdma=%p\n", clk_btif_apdma);
 
 		i_ret = clk_prepare(clk_btif);
 		if (i_ret != 0) {
-- 
2.56.0

