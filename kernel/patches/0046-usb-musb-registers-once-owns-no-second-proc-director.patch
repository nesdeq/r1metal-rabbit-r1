From 3bdb44b9879e27990142ec3a0500b41e8376bae1 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 16:28:09 +0200
Subject: [PATCH] usb: musb registers once, owns no second proc directory, and
 asks for what the board may lack as optional

- musb_core.c registers its platform driver once.
- musb adds its proc files to /proc/mtk_usb, which tphy makes first.
- The id pin and the vusb, va12 and vcc supplies are optional, and
  otg_iddig_probe() takes an interrupt of 0 as none.
- mt_usb_probe() unwinds a failure once and returns its error.
- The role switch registers whatever the sysfs result.
- The tphy procfs inits test the directory they make, and four functions
  take the glue from musb->glue instead of container_of().
---
 drivers/misc/mediatek/extcon/extcon-mtk-usb.c | 14 ++--
 drivers/misc/mediatek/usb20/mt6765/usb20.c    | 77 ++++++++++++-------
 .../misc/mediatek/usb20/mt6765/usb20_host.c   |  2 +-
 drivers/misc/mediatek/usb20/musb_core.c       | 18 -----
 drivers/misc/mediatek/usb20/musb_debugfs.c    | 16 ++--
 drivers/misc/mediatek/usb20/musb_dr.c         |  9 ++-
 drivers/phy/mediatek/phy-mtk-tphy.c           |  4 +-
 drivers/usb/phy/phy-generic.c                 |  2 +-
 8 files changed, 71 insertions(+), 71 deletions(-)

diff --git a/drivers/misc/mediatek/extcon/extcon-mtk-usb.c b/drivers/misc/mediatek/extcon/extcon-mtk-usb.c
index a96086b98..6d5c9aee3 100644
--- a/drivers/misc/mediatek/extcon/extcon-mtk-usb.c
+++ b/drivers/misc/mediatek/extcon/extcon-mtk-usb.c
@@ -487,14 +487,18 @@ static int mtk_usb_extcon_id_pin_init(struct mtk_extcon_info *extcon)
 	int ret = 0;
 	int id;
 
-	extcon->id_gpiod = devm_gpiod_get(extcon->dev, "id", GPIOD_IN);
-
-	if (!extcon->id_gpiod || IS_ERR(extcon->id_gpiod)) {
-		dev_err(extcon->dev, "failed to get id gpio\n");
+	extcon->id_gpiod = devm_gpiod_get_optional(extcon->dev, "id", GPIOD_IN);
+	if (IS_ERR(extcon->id_gpiod)) {
+		ret = PTR_ERR(extcon->id_gpiod);
+		dev_err(extcon->dev, "failed to get id gpio: %d\n", ret);
 		extcon->id_gpiod = NULL;
-		return -EINVAL;
+		return ret;
 	}
 
+	/* a board without an id pin leaves the role to the type-c controller */
+	if (!extcon->id_gpiod)
+		return 0;
+
 	extcon->id_irq = gpiod_to_irq(extcon->id_gpiod);
 	if (extcon->id_irq < 0) {
 		dev_err(extcon->dev, "failed to get ID IRQ\n");
