@@ -2111,7 +2123,7 @@ static int mt_usb_probe(struct platform_device *pdev)
 				pdev->resource, pdev->num_resources);
 	if (ret) {
 		dev_notice(&pdev->dev, "failed to add resources\n");
-		goto err2;
+		goto err_unregister_usb_phy;
 	}
 
