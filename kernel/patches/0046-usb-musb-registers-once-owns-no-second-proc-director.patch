+		reg_va12 = NULL;
+	}
 
 #endif
 
@@ -2026,28 +2036,30 @@ static int mt_usb_probe(struct platform_device *pdev)
 
 	glue->phy = devm_of_phy_get_by_index(&pdev->dev, np, 0);
 	if (IS_ERR(glue->phy)) {
-		dev_err(&pdev->dev, "fail to getting phy %ld\n",
-			PTR_ERR(glue->phy));
-		return PTR_ERR(glue->phy);
+		ret = PTR_ERR(glue->phy);
+		if (ret != -EPROBE_DEFER)
+			dev_err(&pdev->dev, "fail to getting phy %d\n", ret);
+		goto err_put_pdev;
 	}
 
 	glue->usb_phy = usb_phy_generic_register();
 	if (IS_ERR(glue->usb_phy)) {
-		dev_err(&pdev->dev, "fail to registering usb-phy %ld\n",
-			PTR_ERR(glue->usb_phy));
-		return PTR_ERR(glue->usb_phy);
+		ret = PTR_ERR(glue->usb_phy);
+		dev_err(&pdev->dev, "fail to registering usb-phy %d\n", ret);
+		goto err_put_pdev;
 	}
 	glue->xceiv = devm_usb_get_phy(&pdev->dev, USB_PHY_TYPE_USB2);
 	if (IS_ERR(glue->xceiv)) {
-		dev_err(&pdev->dev, "fail to getting usb-phy %d\n", ret);
 		ret = PTR_ERR(glue->xceiv);
+		if (ret != -EPROBE_DEFER)
+			dev_err(&pdev->dev, "fail to getting usb-phy %d\n", ret);
 		goto err_unregister_usb_phy;
 	}
 
 	pdata = devm_kzalloc(&pdev->dev, sizeof(*pdata), GFP_KERNEL);
 	if (!pdata) {
 		dev_notice(&pdev->dev, "failed to allocate musb platform data\n");
-		goto err2;
+		goto err_unregister_usb_phy;
 	}
 
 	config = devm_kzalloc(&pdev->dev, sizeof(*config), GFP_KERNEL);
@@ -2055,7 +2067,7 @@ static int mt_usb_probe(struct platform_device *pdev)
 		/* dev_notice(&pdev->dev,
 		 * "failed to allocate musb hdrc config\n");
 		 */
-		goto err2;
+		goto err_unregister_usb_phy;
 	}
 
