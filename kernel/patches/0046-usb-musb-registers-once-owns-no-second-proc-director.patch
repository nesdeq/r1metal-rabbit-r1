@@ -2135,26 +2147,30 @@ static int mt_usb_probe(struct platform_device *pdev)
 #ifndef FPGA_PLATFORM
 	glue->musb_clk = devm_clk_get(&pdev->dev, "usb0");
 	if (IS_ERR(glue->musb_clk)) {
