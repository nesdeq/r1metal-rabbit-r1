From 20114b4b9b3a10cfc1d348920e8f1f2b396092f3 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 16:09:09 +0200
Subject: [PATCH] sched: eas_plus: a perf order domain not built yet is no
 warning

The scheduler asks before the perf order domains are built, and the
callers act on the return value, so "Perf order domain is not ready!"
prints at info, not at the default warning level.
---
 kernel/sched/extension/eas_plus.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/kernel/sched/extension/eas_plus.c b/kernel/sched/extension/eas_plus.c
index 8178a66cb..7be69363f 100644
--- a/kernel/sched/extension/eas_plus.c
+++ b/kernel/sched/extension/eas_plus.c
@@ -209,7 +209,7 @@ inline unsigned int cpu_is_fastest(int cpu)
 	struct list_head *pos;
 
 	if (!pod_is_ready()) {
-		printk_deferred("Perf order domain is not ready!\n");
+		printk_deferred(KERN_INFO "Perf order domain is not ready!\n");
 		return -1;
 	}
 
@@ -224,7 +224,7 @@ inline unsigned int cpu_is_slowest(int cpu)
 	struct list_head *pos;
 
 	if (!pod_is_ready()) {
-		printk_deferred("Perf order domain is not ready!\n");
+		printk_deferred(KERN_INFO "Perf order domain is not ready!\n");
 		return -1;
 	}
 
@@ -238,7 +238,7 @@ bool is_intra_domain(int prev, int target)
 	struct perf_order_domain *perf_domain = NULL;
 
 	if (!pod_is_ready()) {
-		printk_deferred("Perf order domain is not ready!\n");
+		printk_deferred(KERN_INFO "Perf order domain is not ready!\n");
 		return 0;
 	}
 
