From 69b3140d774ffbab005098c89a753248b90ec4cd Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 21 Oct 2026 11:13:58 +0200
Subject: [PATCH] pwrap: a regmap is handed out only by a wrapper that probed
 and stays bound

- pwrap_node_to_regmap returns -EPROBE_DEFER before the wrapper has
  probed, not a NULL dereference, and drops its device reference.
- msdc_of_parse returns that error, so the SD host defers.
- The wrapper offers no sysfs unbind: it has no remove, and the PMIC's
  devices keep its regmap.
---
 drivers/mmc/host/mediatek/ComboA/mt6765/msdc_cust.c | 2 ++
 drivers/soc/mediatek/mtk-pmic-wrap.c                | 7 ++++++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/mmc/host/mediatek/ComboA/mt6765/msdc_cust.c b/drivers/mmc/host/mediatek/ComboA/mt6765/msdc_cust.c
index e72d63d33..f9f3703f3 100644
--- a/drivers/mmc/host/mediatek/ComboA/mt6765/msdc_cust.c
+++ b/drivers/mmc/host/mediatek/ComboA/mt6765/msdc_cust.c
@@ -1208,6 +1208,8 @@ int msdc_of_parse(struct platform_device *pdev, struct mmc_host *mmc)
 			return -ENODEV;
 
 		regmap = pwrap_node_to_regmap(pwrap_node);
+		if (IS_ERR(regmap))
+			return PTR_ERR(regmap);
 	}
 #endif
 	pr_notice("DT probe %s%d!\n", pdev->dev.of_node->name, id);
diff --git a/drivers/soc/mediatek/mtk-pmic-wrap.c b/drivers/soc/mediatek/mtk-pmic-wrap.c
index 8ab5bd891..843c0b620 100644
--- a/drivers/soc/mediatek/mtk-pmic-wrap.c
+++ b/drivers/soc/mediatek/mtk-pmic-wrap.c
@@ -3089,6 +3089,7 @@ struct regmap *pwrap_node_to_regmap(struct device_node *np)
 {
 	struct platform_device *pdev;
 	struct pmic_wrapper *wrp;
+	struct regmap *regmap;
 
 	pdev = of_find_device_by_node(np);
 
@@ -3096,8 +3097,10 @@ struct regmap *pwrap_node_to_regmap(struct device_node *np)
 		return ERR_PTR(-ENODEV);
 
 	wrp = platform_get_drvdata(pdev);
+	regmap = wrp ? wrp->regmap : ERR_PTR(-EPROBE_DEFER);
+	put_device(&pdev->dev);
 
-	return wrp->regmap;
+	return regmap;
 }
 EXPORT_SYMBOL_GPL(pwrap_node_to_regmap);
 
@@ -3316,6 +3319,8 @@ static struct platform_driver pwrap_drv = {
 	.driver = {
 		.name = "mt-pmic-pwrap",
 		.of_match_table = of_match_ptr(of_pwrap_match_tbl),
+		/* the PMIC's devices keep the regmap an unbind would free */
+		.suppress_bind_attrs = true,
 	},
 	.probe = pwrap_probe,
 };
