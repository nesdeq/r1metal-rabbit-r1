From 8d5e05e2891e4ccc593ea40e0198216d17f4ba0d Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 20:03:27 +0200
Subject: [PATCH] Kconfig: a symbol defined twice has one type

MTK_QOS_FRAMEWORK, CHARGER_BQ25890, MTK_CMDQ and TOUCHSCREEN_GOODIX_BRL
take the type of their other definition, as Kconfig warns of a symbol
of two types. The hx83102p Himax Kconfig, which redefines every symbol
of the 8789p1/8185p3 one, is removed, and TOUCHSCREEN_HIMAX_COMMON
depends on either chipset switch.
---
 drivers/input/touchscreen/mediatek/Kconfig    |   1 -
 .../mediatek/goodix_berlin_driver/Kconfig     |   2 +-
 .../mediatek/hxchipset_8789p1_8185p3/Kconfig  |   2 +-
 .../mediatek/hxchipset_hx83102p/Kconfig       | 169 ------------------
 drivers/misc/mediatek/base/power/Kconfig      |   2 +-
 drivers/power/supply/mediatek/charger/Kconfig |   2 +-
 drivers/soc/mediatek/Kconfig                  |   2 +-
 7 files changed, 5 insertions(+), 175 deletions(-)
 delete mode 100644 drivers/input/touchscreen/mediatek/hxchipset_hx83102p/Kconfig

diff --git a/drivers/input/touchscreen/mediatek/Kconfig b/drivers/input/touchscreen/mediatek/Kconfig
index 1e2c322d9..d86ad6a93 100644
--- a/drivers/input/touchscreen/mediatek/Kconfig
+++ b/drivers/input/touchscreen/mediatek/Kconfig
@@ -190,7 +190,6 @@ config TOUCHSCREEN_HIMAX_CHIPSET
 	report 10 touches at a time.
 
 	If unsure, say N.
-source "drivers/input/touchscreen/mediatek/hxchipset_hx83102p/Kconfig"
 
 config TOUCHSCREEN_GOODIX_BRL
 	bool "Goodix berlin touchscreen"
diff --git a/drivers/input/touchscreen/mediatek/goodix_berlin_driver/Kconfig b/drivers/input/touchscreen/mediatek/goodix_berlin_driver/Kconfig
index b921d37c4..778496801 100644
--- a/drivers/input/touchscreen/mediatek/goodix_berlin_driver/Kconfig
+++ b/drivers/input/touchscreen/mediatek/goodix_berlin_driver/Kconfig
@@ -2,7 +2,7 @@
 # Goodix touchscreen driver configuration
 #
 menuconfig TOUCHSCREEN_GOODIX_BRL
-	tristate "Goodix berlin touchscreen"
+	bool "Goodix berlin touchscreen"
 	help
 	  Say Y here if you have a Goodix berlin series touch controller
 	  to your system
diff --git a/drivers/input/touchscreen/mediatek/hxchipset_8789p1_8185p3/Kconfig b/drivers/input/touchscreen/mediatek/hxchipset_8789p1_8185p3/Kconfig
index 5df6333ed..0e38c052d 100644
--- a/drivers/input/touchscreen/mediatek/hxchipset_8789p1_8185p3/Kconfig
+++ b/drivers/input/touchscreen/mediatek/hxchipset_8789p1_8185p3/Kconfig
@@ -4,7 +4,7 @@
 
 config TOUCHSCREEN_HIMAX_COMMON
         tristate "HIMAX common touchscreen"
-	depends on TOUCHSCREEN_HIMAX_CHIPSET_8789P1_8185P3
+	depends on TOUCHSCREEN_HIMAX_CHIPSET_8789P1_8185P3 || TOUCHSCREEN_HIMAX_CHIPSET
 	help
 	Say Y here to enable support for I2C based touchscreens.
 	To compile this driver as a module, choose M here: the
diff --git a/drivers/input/touchscreen/mediatek/hxchipset_hx83102p/Kconfig b/drivers/input/touchscreen/mediatek/hxchipset_hx83102p/Kconfig
deleted file mode 100644
