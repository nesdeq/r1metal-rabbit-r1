From 5ee334b12c958c6a31f58b474723d77533839afe Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 10:36:03 +0200
Subject: [PATCH] clk: mt6765-pg: wait for the CONN bus protect's acknowledge,
 not for its absence

Step 1 of the CONN bus protect at power down waits until its acknowledge
is set, as the other steps and the mt6761 and mt6768 flows do. Waiting
while it is set ends only through the timeout recovery, with a register
dump and a bus hang report at every power down.
---
 drivers/clk/mediatek/clk-mt6765-pg.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/mediatek/clk-mt6765-pg.c b/drivers/clk/mediatek/clk-mt6765-pg.c
index 531f7af6d..7de2f6282 100644
--- a/drivers/clk/mediatek/clk-mt6765-pg.c
+++ b/drivers/clk/mediatek/clk-mt6765-pg.c
@@ -868,9 +868,10 @@ static int spm_mtcmos_ctrl_conn_bus_prot(int state)
 		spm_write(INFRA_TOPAXI_PROTECTEN_1_SET,
 			CONN_PROT_STEP1_1_MASK);
 #ifndef IGNORE_MTCMOS_CHECK
+		/* Wait for the acknowledge, as mt6761 and mt6768 do; the recovery bounds the wait. */
 		while ((spm_read(INFRA_TOPAXI_PROTECTEN_STA1_1)
 			& CONN_PROT_STEP1_1_ACK_MASK)
-			== CONN_PROT_STEP1_1_ACK_MASK) {
+			!= CONN_PROT_STEP1_1_ACK_MASK) {
 			ram_console_update();
 			if (DBG_STEP == CONN_TIMEOUT_RECOVERY)
 				break;
-- 
