From 7d780ba6a9bb2e868519cdb65ab69a99d9905780 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Mon, 19 Oct 2026 15:44:53 +0200
Subject: [PATCH] musb: a request given back is unmapped by the mapping's own
 record

musb_g_giveback calls unmap_dma_buffer for every request, which goes
by the map_state map_dma_buffer records and skips a request never
mapped. Upstream's own test reports every request it does not unmap,
each zero length packet of QMU among them, as dma_mapping_error.
---
 drivers/misc/mediatek/usb20/musb_gadget.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/drivers/misc/mediatek/usb20/musb_gadget.c b/drivers/misc/mediatek/usb20/musb_gadget.c
index 4e417dc69..908980b5b 100644
--- a/drivers/misc/mediatek/usb20/musb_gadget.c
+++ b/drivers/misc/mediatek/usb20/musb_gadget.c
@@ -210,11 +210,7 @@ void musb_g_giveback(struct musb_ep *ep,
 		goto lock;
 	}
 
-	if (!dma_mapping_error(musb->controller, request->dma) &&
-			req->request.length != 0)
-		unmap_dma_buffer(req, musb);
-	else if (req->epnum != 0)
-		DBG(0, "%s dma_mapping_error\n", ep->end_point.name);
+	unmap_dma_buffer(req, musb);
 
 	if (request->status == 0)
 		DBG(1, "%s done request %p,  %d/%d\n",
-- 
2.56.0

