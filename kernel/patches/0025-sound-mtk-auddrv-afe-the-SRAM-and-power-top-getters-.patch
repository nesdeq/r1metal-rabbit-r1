From f6619c93faf37487ee1532bf8f23988a2f6df0f0 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 15:19:31 +0200
Subject: [PATCH] sound: mtk-auddrv-afe: the SRAM and power top getters take no
 arguments

The three getters are defined with (void), as the header declares them;
clang 23 rejects the empty lists against those prototypes.
---
 sound/soc/mediatek/common_int/mtk-auddrv-afe.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/sound/soc/mediatek/common_int/mtk-auddrv-afe.c b/sound/soc/mediatek/common_int/mtk-auddrv-afe.c
index 1746ac41b..ef8dd253e 100644
--- a/sound/soc/mediatek/common_int/mtk-auddrv-afe.c
+++ b/sound/soc/mediatek/common_int/mtk-auddrv-afe.c
@@ -156,12 +156,12 @@ dma_addr_t Get_Afe_Sram_Capture_Phys_Addr(void)
 	return (dma_addr_t)(AFE_INTERNAL_SRAM_PHY_BASE + SramCaptureOffSet);
 }
 
-void *Get_Afe_SramBase_Pointer()
+void *Get_Afe_SramBase_Pointer(void)
 {
 	return AFE_SRAM_ADDRESS;
 }
 
-void *Get_Afe_SramCaptureBase_Pointer()
+void *Get_Afe_SramCaptureBase_Pointer(void)
 {
 	char *CaptureSramPointer =
 		(char *)(AFE_SRAM_ADDRESS) + SramCaptureOffSet;
@@ -169,7 +169,7 @@ void *Get_Afe_SramCaptureBase_Pointer()
 	return (void *)CaptureSramPointer;
 }
 
-void *Get_Afe_Powertop_Pointer()
+void *Get_Afe_Powertop_Pointer(void)
 {
 	return AFE_TOP_ADDRESS;
 }
