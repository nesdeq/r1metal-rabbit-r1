From a6f0bcc3139f50dd555d540ac3b773ba8fbc9609 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Mon, 19 Oct 2026 16:06:29 +0200
Subject: [PATCH] charger: a power supply whose charger is not bound has no
 data

psy_charger_get_property answers -ENODATA for the charging current and
the input current limit while no charger device is bound, and for an
unknown power supply, so a uevent leaves the property out. Both
supplies register before a charger is bound, and upstream logs four
failures at their first uevents.
---
 drivers/power/supply/mtk_charger.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/mtk_charger.c b/drivers/power/supply/mtk_charger.c
index f6c0c10f3..f71b1ffeb 100644
--- a/drivers/power/supply/mtk_charger.c
+++ b/drivers/power/supply/mtk_charger.c
@@ -1948,7 +1948,7 @@ static int psy_charger_get_property(struct power_supply *psy,
 		chg = info->chg2_dev;
 	else {
 		chr_err("%s fail\n", __func__);
-		return 0;
+		return -ENODATA;
 	}
 
 	switch (psp) {
@@ -1978,9 +1978,13 @@ static int psy_charger_get_property(struct power_supply *psy,
 			val->intval = -127;
 		break;
 	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		if (chg == NULL)
+			return -ENODATA;
 		val->intval = get_charger_charging_current(info, chg);
 		break;
 	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		if (chg == NULL)
+			return -ENODATA;
 		val->intval = get_charger_input_current(info, chg);
 		break;
 	case POWER_SUPPLY_PROP_USB_TYPE:
