From 496af865c4d5effc0314262350549f626677d973 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 21 Oct 2026 10:40:46 +0200
Subject: [PATCH] cm_mgr: the probe checks what it allocated and frees nothing
 of devm's

- platform_cm_mgr_probe tests the allocation of cm_mgr_perfs, not
  cm_mgr_num_perf, and undoes cm_mgr_common_init on a later failure.
- cm_mgr_common_init puts its kobject where fb_register_client fails.
- cpu_power_bcpu_weight_max and _min keep the tree's values, 100 where
  it gives none.
- cm_mgr_cpu_opp_to_dram is counted as u32 elements, not as phandles.
- The devm allocations are not kfreed; the device's release frees them.
- The driver offers no sysfs unbind, which its cpufreq, CPU PM, hotplug
  and QoS hooks would outlive.
---
 drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_common.c | 16 ++++++++--------
 drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_mt6765.c | 11 +++++------
 2 files changed, 13 insertions(+), 14 deletions(-)

diff --git a/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_common.c b/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_common.c
index cd6a79d35..cb1fa082e 100644
--- a/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_common.c
+++ b/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_common.c
@@ -601,9 +601,10 @@ int cm_mgr_check_dts_setting(struct platform_device *pdev)
 			cm_mgr_base);
 
 	/* cm_mgr_cpu_opp_to_dram is optional: a tree without it has no entries */
-	opp_count = of_count_phandle_with_args(node,
-			"cm_mgr_cpu_opp_to_dram", NULL);
-	if (opp_count == -ENOENT)
+	if (of_find_property(node, "cm_mgr_cpu_opp_to_dram", NULL))
+		opp_count = of_property_count_u32_elems(node,
+				"cm_mgr_cpu_opp_to_dram");
+	else
 		opp_count = 0;
 	pr_info("#@# %s(%d) opp_count %d\n",
 			__func__, __LINE__, opp_count);
@@ -672,14 +673,14 @@ int cm_mgr_check_dts_setting(struct platform_device *pdev)
 
 	ret = of_property_read_s32(node, "cpu_power_bcpu_weight_max",
 			&cpu_power_bcpu_weight_max);
-	if (!ret)
+	if (ret)
 		cpu_power_bcpu_weight_max = 100;
 	pr_info("#@# %s(%d) cpu_power_bcpu_weight_max %d\n",
 			__func__, __LINE__, cpu_power_bcpu_weight_max);
 
 	ret = of_property_read_s32(node, "cpu_power_bcpu_weight_min",
 			&cpu_power_bcpu_weight_min);
-	if (!ret)
+	if (ret)
 		cpu_power_bcpu_weight_min = 100;
 	pr_info("#@# %s(%d) cpu_power_bcpu_weight_min %d\n",
 			__func__, __LINE__, cpu_power_bcpu_weight_min);
@@ -690,7 +691,7 @@ int cm_mgr_check_dts_setting(struct platform_device *pdev)
 
 	if (!cm_mgr_buf) {
 		ret = -ENOMEM;
-		goto ERROR1;
+		goto ERROR;
 	}
 
 	cpu_power_ratio_down = cm_mgr_buf;
@@ -715,8 +716,6 @@ int cm_mgr_check_dts_setting(struct platform_device *pdev)
 
 	return 0;
 
-ERROR1:
-	kfree(cm_mgr_cpu_opp_to_dram);
 ERROR:
 	return ret;
 }
@@ -741,6 +740,7 @@ int cm_mgr_common_init(void)
 	ret = fb_register_client(&cm_mgr_fb_notifier);
 	if (ret) {
 		pr_info("[CM_MGR] FAILED TO REGISTER FB CLIENT (%d)\n", ret);
+		kobject_put(cm_mgr_kobj);
 		return ret;
 	}
 
diff --git a/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_mt6765.c b/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_mt6765.c
index e3195e97a..9ed9c38c2 100644
--- a/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_mt6765.c
+++ b/drivers/misc/mediatek/cm_mgr/mtk_cm_mgr_mt6765.c
@@ -1226,7 +1226,7 @@ static int platform_cm_mgr_probe(struct platform_device *pdev)
 				cm_mgr_num_perf * sizeof(int),
 				GFP_KERNEL);
 
-		if (!cm_mgr_num_perf) {
+		if (!cm_mgr_perfs) {
 			ret = -ENOMEM;
 			goto ERROR;
 		}
@@ -1247,7 +1247,7 @@ static int platform_cm_mgr_probe(struct platform_device *pdev)
 	ret = cm_mgr_check_dts_setting(pdev);
 	if (ret) {
 		pr_info("[CM_MGR] FAILED TO GET DTS DATA(%d)\n", ret);
-		return ret;
+		goto ERROR;
 	}
 
 	cm_mgr_pdev = pdev;
@@ -1292,6 +1292,7 @@ static int platform_cm_mgr_probe(struct platform_device *pdev)
 	return 0;
 
 ERROR:
+	cm_mgr_common_exit();
 	return ret;
 }
 
@@ -1301,10 +1302,6 @@ static int platform_cm_mgr_remove(struct platform_device *pdev)
 
 	cm_mgr_common_exit();
 
-	kfree(cm_mgr_perfs);
-	kfree(cm_mgr_cpu_opp_to_dram);
-	kfree(cm_mgr_buf);
-
 	return 0;
 }
 
@@ -1325,6 +1322,8 @@ static struct platform_driver mtk_platform_cm_mgr_driver = {
 		.name = "mt6765-cm_mgr",
 		.owner = THIS_MODULE,
 		.of_match_table = platform_cm_mgr_of_match,
+		/* the probe's cpufreq, CPU PM, hotplug and QoS hooks outlive an unbind */
+		.suppress_bind_attrs = true,
 	},
 	.id_table = platform_cm_mgr_id_table,
 };
-- 
2.56.0

