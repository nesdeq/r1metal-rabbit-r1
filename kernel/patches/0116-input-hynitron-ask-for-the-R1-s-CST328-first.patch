From f1f6799fce67c3cb40613331731cdd695ccd7b8c Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Mon, 19 Oct 2026 19:48:18 +0200
Subject: [PATCH] input: hynitron: ask for the R1's CST328 first

hyn_ts_data_init asks for the R1's CST328 at 0x1a first, by a one byte
bare read, and for the CST836 at 0x15 only where nothing answers, so the
R1's probe makes no transfer to an empty address. hyn_probe waits its 60
ms before the detection, past the CST328's bootloader, which answers at
0x1a in the first milliseconds after the reset.
---
 .../input/touchscreen/CST8xx/hynitron_core.c  | 31 ++++++++++++++-----
 1 file changed, 23 insertions(+), 8 deletions(-)

diff --git a/drivers/input/touchscreen/CST8xx/hynitron_core.c b/drivers/input/touchscreen/CST8xx/hynitron_core.c
index 36e8897f8..ff035c831 100644
--- a/drivers/input/touchscreen/CST8xx/hynitron_core.c
+++ b/drivers/input/touchscreen/CST8xx/hynitron_core.c
@@ -1630,10 +1630,19 @@ static int hyn_i2c_probe_read(struct i2c_client *client, u8 *reg, u8 *data)
 	return mtk_i2c_transfer(client->adapter, &read, 1, I2C_A_FILTER_MSG, 0);
 }
 
+/* A bare read, which a chip at addr acknowledges and which moves no more than its read pointer. */
+static int hyn_i2c_probe_answer(struct i2c_client *client, u16 addr)
+{
+	u8 data;
+	struct i2c_msg read = { .addr = addr, .flags = I2C_M_RD, .len = 1, .buf = &data };
+
+	return mtk_i2c_transfer(client->adapter, &read, 1, I2C_A_FILTER_MSG, 0);
+}
+
 void hyn_ts_data_init(struct i2c_client *client)
 {
 	unsigned char scan_id;
-	int ret = -1;
+	bool mutual;
 	unsigned char reg_buf[2];
 	unsigned char buf[4];
 
@@ -1670,10 +1679,15 @@ void hyn_ts_data_init(struct i2c_client *client)
 		client->addr						=HYN_MAIN_IIC_ADDR_CONFIG;	
 		HYN_DEBUG("client addr is different,now use default addr,please confirm. client->addr=0x%x, default iic addr=0x%x.\r\n",client->addr,HYN_MAIN_IIC_ADDR_CONFIG);
 	}
-	reg_buf[0] = 0xA6;	
-	ret = hyn_i2c_probe_read(hyn_ts_data->client,reg_buf,buf);
-	if (ret < 0){
-		HYN_INFO("no chip answers at 0x%x, taking the mutual capacitance chip at 0x%x", client->addr, HYN_MAIN_IIC_ADDR_CONFIG_BACK);
+	/* The CST328 the R1 carries is asked first, at 0x1a; the CST836 only where nothing answers there. */
+	mutual = hyn_i2c_probe_answer(client, HYN_MAIN_IIC_ADDR_CONFIG_BACK) >= 0;
+	if (!mutual) {
+		reg_buf[0] = 0xA6;
+		mutual = hyn_i2c_probe_read(hyn_ts_data->client, reg_buf, buf) < 0;
+		if (mutual)
+			HYN_INFO("no chip answers at 0x%x or 0x%x, taking the mutual capacitance chip at 0x%x", HYN_MAIN_IIC_ADDR_CONFIG_BACK, client->addr, HYN_MAIN_IIC_ADDR_CONFIG_BACK);
+	}
+	if (mutual){
 		hyn_ts_data->config_chip_type		=HYN_CHIP_TYPE_CONFIG_BACK;
 		hyn_ts_data->config_chip_product_line =HYN_CHIP_PRODUCT_LINE_MUT_CAP;				
 	
@@ -1901,10 +1915,11 @@ static int hyn_probe(struct i2c_client *client, const struct i2c_device_id *id)
 		HYN_ERROR("hyn_gpio_configure fail");
 		return -1;
 	}	
-	hyn_ts_data_init(client); 
-	
+	/* The CST328's bootloader answers at 0x1a in the first milliseconds after hyn_gpio_configure()'s reset. */
 	mdelay(60);
-	
+
+	hyn_ts_data_init(client);
+
 	ret=hyn_firmware_info(client);
 	if(ret<0){
 		HYN_ERROR("hyn_firmware_info failed,start check boot.\n");
-- 
