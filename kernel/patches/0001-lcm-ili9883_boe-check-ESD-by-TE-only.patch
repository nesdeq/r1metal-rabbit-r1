From 37e68c3a7591dd43d0d8104bb3c7cf1f7b52162f Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Thu, 8 Oct 2026 16:18:48 +0200
Subject: [PATCH] lcm: ili9883_boe: check ESD by TE only

The register read of the ESD check stops the DSI video stream and drops
a refresh every second check cycle. Without lcm_esd_check_table entries
the check stays on the TE interrupt, which costs no frame.
---
 .../lcm/ili9883_boe_mipi_hd/ili9883_boe_mipi_hd.c         | 8 +-------
 1 file changed, 1 insertion(+), 7 deletions(-)

diff --git a/drivers/misc/mediatek/lcm/ili9883_boe_mipi_hd/ili9883_boe_mipi_hd.c b/drivers/misc/mediatek/lcm/ili9883_boe_mipi_hd/ili9883_boe_mipi_hd.c
index d22410610..ffa127f7f 100755
--- a/drivers/misc/mediatek/lcm/ili9883_boe_mipi_hd/ili9883_boe_mipi_hd.c
+++ b/drivers/misc/mediatek/lcm/ili9883_boe_mipi_hd/ili9883_boe_mipi_hd.c
@@ -281,13 +281,7 @@ static void lcm_get_params(struct LCM_PARAMS *params)
 
 	params->dsi.esd_check_enable = 1;
 	params->dsi.customization_esd_check_enable = 0;
-	params->dsi.lcm_esd_check_table[0].cmd = 0x0A;
-	params->dsi.lcm_esd_check_table[0].count = 1;
-	params->dsi.lcm_esd_check_table[0].para_list[0] = 0x9C;
-
-	params->dsi.lcm_esd_check_table[1].cmd = 0xE5;
-	params->dsi.lcm_esd_check_table[1].count = 1;
-	params->dsi.lcm_esd_check_table[1].para_list[0] = 0x00;
+	/* No register table: a register read drops a frame; the check stays on the TE interrupt. */
 
 	params->dsi.ssc_disable = 1;
 }
