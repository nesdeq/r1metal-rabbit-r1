From dcde40e02765cf8df161d378b4d9562b53e5e46b Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 20:03:27 +0200
Subject: [PATCH] pm: suspend's routine lines print at info

Each suspend's and resume's routine lines print at KERN_INFO in place
of warnings: SPM's entry, exit and sleep figures, Chip_pm_begin, the
SCP's state, the waking IRQ and an IRQ moved off an offline CPU. A
freeze a wakeup aborts is info, not an error, as it is no fault.
mtk_spm.c's second PM notifier, which repeats the suspend entry and
exit lines, is removed.
---
 drivers/base/power/wakeup.c                   |  2 +-
 .../base/power/spm/common/mtk_sleep.c         |  6 +--
 .../mediatek/base/power/spm/mt6765/mtk_spm.c  | 46 -------------------
 .../base/power/spm/mt6765/mtk_spm_suspend.c   |  8 ++--
 .../spm/mt6765/mtk_spm_suspend_process.c      |  4 +-
 .../base/power/spm/mt6765/mtk_spm_utils.c     |  2 +-
 drivers/misc/mediatek/scp/cm4/scp_dvfs.c      |  2 +-
 kernel/irq/cpuhotplug.c                       |  2 +-
 kernel/power/process.c                        |  2 +-
 9 files changed, 14 insertions(+), 60 deletions(-)

diff --git a/drivers/base/power/wakeup.c b/drivers/base/power/wakeup.c
index 07762edad..c7eee03ab 100644
--- a/drivers/base/power/wakeup.c
+++ b/drivers/base/power/wakeup.c
@@ -941,7 +941,7 @@ void pm_system_irq_wakeup(unsigned int irq_number)
 			name = desc->action->name;
 
 		log_irq_wakeup_reason(irq_number);
-		pr_warn("%s: %d triggered %s\n", __func__, irq_number, name);
+		pr_info("%s: %d triggered %s\n", __func__, irq_number, name);
 
 		pm_wakeup_irq = irq_number;
 		pm_system_wakeup();
diff --git a/drivers/misc/mediatek/base/power/spm/common/mtk_sleep.c b/drivers/misc/mediatek/base/power/spm/common/mtk_sleep.c
