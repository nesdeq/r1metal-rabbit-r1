From be3f2761a319255a82c3e589250d6b6f71037a17 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Mon, 19 Oct 2026 14:14:56 +0200
Subject: [PATCH] step_motor_ms35774: the wait between the homing and the turn
 to 90 sleeps

ms35774_init_work_handler waits the 2 s between the homing and the
turn to 90 with msleep. Spinning 2 s in mdelay holds up every work
queued to its CPU's system workqueue pool, among them an eMMC rescan,
which then brings the card up after init has made the device nodes.
---
 drivers/misc/step_motor_ms35774.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/misc/step_motor_ms35774.c b/drivers/misc/step_motor_ms35774.c
index b425923ca..9bb034a48 100644
--- a/drivers/misc/step_motor_ms35774.c
+++ b/drivers/misc/step_motor_ms35774.c
@@ -173,7 +173,7 @@ static void ms35774_init_work_handler(struct work_struct *work)
   data->orientation_request = 0;
   data->run_flag = true;
   wake_up_interruptible(&m35774_run_thread_waiter);
-  mdelay(2000);
+  msleep(2000);
   data->orientation_request = 90;
   data->run_flag = true;
   wake_up_interruptible(&m35774_run_thread_waiter);
-- 
