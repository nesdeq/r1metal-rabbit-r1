 extern INT32 gHifSdioDbgLvl;
 
 
+/* the loud and debug lines print while printk.debug is set too */
 #define HIF_SDIO_LOUD_FUNC(fmt, arg...)	\
-do { if (gHifSdioDbgLvl >= HIF_SDIO_LOG_LOUD)	\
+do { if (gHifSdioDbgLvl >= HIF_SDIO_LOG_LOUD || printk_debugging())	\
 	printk(KERN_DEBUG DFT_TAG"[L]%s:"  fmt, __func__, ##arg);	\
 } while (0)
 #define HIF_SDIO_DBG_FUNC(fmt, arg...)	\
-do { if (gHifSdioDbgLvl >= HIF_SDIO_LOG_DBG)	\
+do { if (gHifSdioDbgLvl >= HIF_SDIO_LOG_DBG || printk_debugging())	\
 	printk(KERN_DEBUG DFT_TAG"[D]%s:"  fmt, __func__, ##arg);	\
 } while (0)
 #define HIF_SDIO_INFO_FUNC(fmt, arg...)	\
diff --git a/connectivity/common/common_main/linux/include/osal.h b/connectivity/common/common_main/linux/include/osal.h
index c2d0412..600c4fa 100644
--- a/connectivity/common/common_main/linux/include/osal.h
+++ b/connectivity/common/common_main/linux/include/osal.h
@@ -123,10 +123,10 @@ do { \
 /* The jiffies msleep(ms) waits, the bound of a poll that replaces it. */
 #define OSAL_MSLEEP_JIFFIES(ms) (msecs_to_jiffies(ms) + 1)
 
-/* Logs a poll's time, named by what, while wait_log is set. */
+/* Logs a poll's time, named by what, while wait_log or printk.debug is set. */
 #define OSAL_WAIT_LOG(what, start) \
 do { \
-	if (osal_wait_log) \
+	if (osal_wait_log || printk_debugging()) \
 		pr_info("[WMT-WAIT]%s: %s took %lld us\n", __func__, what, ktime_to_us(ktime_sub(ktime_get(), start))); \
 } while (0)
 
