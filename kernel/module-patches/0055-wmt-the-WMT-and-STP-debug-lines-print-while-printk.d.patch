 		pr_info(PFX_STP_DBG "%s: "  fmt, __func__, ##arg); \
 } while (0)
 #define STP_DBG_PR_DBG(fmt, arg...) \
 do { \
-	if (gStpDbgDbgLevel >= STP_DBG_LOG_DBG) \
+	if (gStpDbgDbgLevel >= STP_DBG_LOG_DBG || printk_debugging()) \
 		pr_info(PFX_STP_DBG "%s: "  fmt, __func__, ##arg); \
 } while (0)
 #define STP_DBG_PR_INFO(fmt, arg...) \
diff --git a/connectivity/common/common_main/linux/stp_sdio.c b/connectivity/common/common_main/linux/stp_sdio.c
