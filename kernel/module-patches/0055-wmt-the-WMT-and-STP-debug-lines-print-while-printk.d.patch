diff --git a/connectivity/common/common_main/linux/include/hif_sdio.h b/connectivity/common/common_main/linux/include/hif_sdio.h
index 474803c..d0a3d02 100644
--- a/connectivity/common/common_main/linux/include/hif_sdio.h
+++ b/connectivity/common/common_main/linux/include/hif_sdio.h
