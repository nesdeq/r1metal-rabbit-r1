From f3da6a2dd8e633c935707bb7095c123c38e31651 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 21 Oct 2026 13:43:11 +0200
Subject: [PATCH] wmt: the WMT and STP debug lines print while printk.debug is
 set

The level-gated debug macros of WMT, STP and their layers (platform,
detect, combo stub, BTM, PSM, HIF-SDIO, STP-SDIO, STP-UART),
OSAL_WAIT_LOG and the thermal table dump print while printk_debugging()
is true, each at its own level.
---
 connectivity/common/common_detect/mtk_wcn_stub_alps.c    | 3 ++-
 connectivity/common/common_detect/wmt_detect.h           | 5 +++--
 connectivity/common/common_main/core/btm_core.c          | 5 +++--
 connectivity/common/common_main/core/include/stp_core.h  | 9 +++++----
 connectivity/common/common_main/core/psm_core.c          | 7 ++++---
 connectivity/common/common_main/include/wmt_exp.h        | 7 ++++---
 connectivity/common/common_main/include/wmt_plat.h       | 5 +++--
 connectivity/common/common_main/linux/include/hif_sdio.h | 5 +++--
 connectivity/common/common_main/linux/include/osal.h     | 4 ++--
 connectivity/common/common_main/linux/include/stp_dbg.h  | 5 +++--
 connectivity/common/common_main/linux/stp_sdio.c         | 7 ++++---
 connectivity/common/common_main/linux/stp_uart.c         | 3 ++-
 connectivity/common/common_main/linux/wmt_dev.c          | 2 +-
 13 files changed, 39 insertions(+), 28 deletions(-)

diff --git a/connectivity/common/common_detect/mtk_wcn_stub_alps.c b/connectivity/common/common_detect/mtk_wcn_stub_alps.c
index cf281b4..58b6334 100644
--- a/connectivity/common/common_detect/mtk_wcn_stub_alps.c
+++ b/connectivity/common/common_detect/mtk_wcn_stub_alps.c
@@ -49,9 +49,10 @@ do { \
 	if (gCmbStubLogLevel >= CMB_STUB_WARN_LOG) \
 		pr_warn(fmt, ##arg); \
 } while (0)
+/* a debug line prints while printk.debug is set too */
 #define CMB_STUB_LOG_PR_DBG(fmt, arg...) \
 do { \
-	if (gCmbStubLogLevel >= CMB_STUB_DBG_LOG) \
+	if (gCmbStubLogLevel >= CMB_STUB_DBG_LOG || printk_debugging()) \
 		pr_info(fmt, ##arg); \
 } while (0)
 
diff --git a/connectivity/common/common_detect/wmt_detect.h b/connectivity/common/common_detect/wmt_detect.h
index 3c4150d..837c77e 100644
--- a/connectivity/common/common_detect/wmt_detect.h
+++ b/connectivity/common/common_detect/wmt_detect.h
@@ -52,14 +52,15 @@
 
 extern int gWmtDetectDbgLvl;
 
+/* the loud and debug lines print while printk.debug is set too */
 #define WMT_DETECT_PR_LOUD(fmt, arg...) \
 do { \
-	if (gWmtDetectDbgLvl >= WMT_DETECT_LOG_LOUD) \
+	if (gWmtDetectDbgLvl >= WMT_DETECT_LOG_LOUD || printk_debugging()) \
 		pr_info(DFT_TAG"[L]%s:"  fmt, __func__, ##arg); \
 } while (0)
 #define WMT_DETECT_PR_DBG(fmt, arg...) \
 do { \
-	if (gWmtDetectDbgLvl >= WMT_DETECT_LOG_DBG) \
+	if (gWmtDetectDbgLvl >= WMT_DETECT_LOG_DBG || printk_debugging()) \
 		pr_info(DFT_TAG"[D]%s:"  fmt, __func__, ##arg); \
 } while (0)
 #define WMT_DETECT_PR_INFO(fmt, arg...) \
diff --git a/connectivity/common/common_main/core/btm_core.c b/connectivity/common/common_main/core/btm_core.c
index a77460b..aec8b53 100644
--- a/connectivity/common/common_main/core/btm_core.c
+++ b/connectivity/common/common_main/core/btm_core.c
@@ -35,14 +35,15 @@
 
 INT32 gBtmDbgLevel = STP_BTM_LOG_INFO;
 
+/* the loud and debug lines print at their level or while printk.debug is set */
 #define STP_BTM_PR_LOUD(fmt, arg...) \
 do { \
-	if (gBtmDbgLevel >= STP_BTM_LOG_LOUD) \
+	if (gBtmDbgLevel >= STP_BTM_LOG_LOUD || printk_debugging()) \
 		pr_info(PFX_BTM "%s: "  fmt, __func__, ##arg); \
 } while (0)
 #define STP_BTM_PR_DBG(fmt, arg...) \
 do { \
-	if (gBtmDbgLevel >= STP_BTM_LOG_DBG) \
+	if (gBtmDbgLevel >= STP_BTM_LOG_DBG || printk_debugging()) \
 		pr_info(PFX_BTM "%s: "  fmt, __func__, ##arg); \
 } while (0)
 #define STP_BTM_PR_INFO(fmt, arg...) \
diff --git a/connectivity/common/common_main/core/include/stp_core.h b/connectivity/common/common_main/core/include/stp_core.h
index d3fb744..c8db4db 100644
--- a/connectivity/common/common_main/core/include/stp_core.h
+++ b/connectivity/common/common_main/core/include/stp_core.h
@@ -55,8 +55,9 @@
 
 extern INT32 gStpDbgLvl;
 
+/* the debug, trace and packet head lines print at their level or while printk.debug is set */
 #define STP_DBG_FUNC(fmt, arg...)    do {\
-	if (gStpDbgLvl >= STP_LOG_DBG)\
+	if (gStpDbgLvl >= STP_LOG_DBG || printk_debugging())\
 		printk(KERN_DEBUG PFX "%s: " fmt, __func__, ##arg);\
 } while (0)
 
@@ -82,17 +83,17 @@ extern INT32 gStpDbgLvl;
 } while (0)
 
 #define STP_TRC_FUNC(f)              do {\
-	if (gStpDbgLvl >= STP_LOG_DBG)\
+	if (gStpDbgLvl >= STP_LOG_DBG || printk_debugging())\
 		printk(KERN_DEBUG PFX "<%s> <%d>\n", __func__, __LINE__);\
 } while (0)
 
 #define STP_DUMP_PACKET_HEAD(a, b, c)     do {\
-	if (gStpDbgLvl >= STP_LOG_PKHEAD)\
+	if (gStpDbgLvl >= STP_LOG_PKHEAD || printk_debugging())\
 		stp_dump_data(a, b, c);\
 } while (0)
 
 #define STP_TRACE_FUNC(fmt, arg...)       do {\
-	if (gStpDbgLvl >= STP_LOG_DBG)\
+	if (gStpDbgLvl >= STP_LOG_DBG || printk_debugging())\
 		printk(KERN_DEBUG PFX "%s: " fmt, __func__, ##arg);\
 } while (0)
 
diff --git a/connectivity/common/common_main/core/psm_core.c b/connectivity/common/common_main/core/psm_core.c
index f4f7700..f4aa2d8 100644
--- a/connectivity/common/common_main/core/psm_core.c
+++ b/connectivity/common/common_main/core/psm_core.c
@@ -34,14 +34,15 @@ static UINT32 g_opid_record_num;
 static UINT32 stp_traffic_start;
 static UINT32 stp_traffic_current;
 
+/* the loud and debug lines print at their level or while printk.debug is set */
 #define STP_PSM_PR_LOUD(fmt, arg...) \
 do { \
-	if (gPsmDbgLevel >= STP_PSM_LOG_LOUD) \
+	if (gPsmDbgLevel >= STP_PSM_LOG_LOUD || printk_debugging()) \
 		pr_info(PFX_PSM "%s: "  fmt, __func__, ##arg); \
 } while (0)
 #define STP_PSM_PR_DBG(fmt, arg...) \
 do { \
-	if (gPsmDbgLevel >= STP_PSM_LOG_DBG) \
+	if (gPsmDbgLevel >= STP_PSM_LOG_DBG || printk_debugging()) \
 		pr_info(PFX_PSM "%s: "  fmt, __func__, ##arg); \
 } while (0)
 #define STP_PSM_PR_INFO(fmt, arg...) \
@@ -602,7 +603,7 @@ handler_done:
 
 static inline INT32 _stp_psm_get_time(VOID)
 {
-	if (gPsmDbgLevel >= STP_PSM_LOG_LOUD)
+	if (gPsmDbgLevel >= STP_PSM_LOG_LOUD || printk_debugging())
 		osal_printtimeofday("<psm time>>>>");
 
 	return 0;
diff --git a/connectivity/common/common_main/include/wmt_exp.h b/connectivity/common/common_main/include/wmt_exp.h
index 251f2ed..c5b3606 100644
