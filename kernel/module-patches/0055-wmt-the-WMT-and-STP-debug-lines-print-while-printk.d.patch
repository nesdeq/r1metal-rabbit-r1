diff --git a/connectivity/common/common_main/linux/wmt_dev.c b/connectivity/common/common_main/linux/wmt_dev.c
index 1724d58..c436765 100644
--- a/connectivity/common/common_main/linux/wmt_dev.c
+++ b/connectivity/common/common_main/linux/wmt_dev.c
@@ -750,7 +750,7 @@ LONG wmt_dev_tm_temp_query(VOID)
 	/*  */
 	/* Dump information */
 	/*  */
-	if ((gWmtDbgLvl >= WMT_LOG_DBG) || (return_temp > MAX_TEMP)) {
+	if ((gWmtDbgLvl >= WMT_LOG_DBG) || printk_debugging() || (return_temp > MAX_TEMP)) {
 		osal_lock_unsleepable_lock(&g_temp_query_spinlock);
 		WMT_INFO_FUNC("[Thermal] s_idx_temp_table = %d, idx_temp_table = %d\n",
 			s_idx_temp_table, idx_temp_table);
