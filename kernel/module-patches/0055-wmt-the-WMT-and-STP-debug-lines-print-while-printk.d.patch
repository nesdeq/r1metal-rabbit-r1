 		printk(KERN_DEBUG DFT_TAG "[L]%s:"  fmt, __func__, ##arg); \
 } while (0)
 #define WMT_INFO_FUNC(fmt, arg...)  \
@@ -62,12 +63,12 @@ do { \
 } while (0)
 #define WMT_DBG_FUNC(fmt, arg...) \
 do { \
-	if (gWmtDbgLvl >= WMT_LOG_DBG) \
+	if (gWmtDbgLvl >= WMT_LOG_DBG || printk_debugging()) \
 		printk(KERN_DEBUG DFT_TAG "[D]%s:"  fmt, __func__, ##arg); \
 } while (0)
