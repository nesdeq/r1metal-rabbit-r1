 do { \
-	if (gWmtDbgLvl >= WMT_LOG_DBG) \
+	if (gWmtDbgLvl >= WMT_LOG_DBG || printk_debugging()) \
 		printk(KERN_DEBUG DFT_TAG "<%s> <%d>\n", __func__, __LINE__); \
 } while (0)
 
