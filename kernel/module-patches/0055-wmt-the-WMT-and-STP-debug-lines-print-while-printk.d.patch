 		pr_info(DFT_TAG "[D]%s:"  fmt, __func__, ##arg); \
 } while (0)
 
 #define STPSDIO_PR_HINT(fmt, arg...) \
 do { \
-	if (gStpSdioDbgLvl >= STPSDIO_LOG_HINT) \
+	if (gStpSdioDbgLvl >= STPSDIO_LOG_HINT || printk_debugging()) \
