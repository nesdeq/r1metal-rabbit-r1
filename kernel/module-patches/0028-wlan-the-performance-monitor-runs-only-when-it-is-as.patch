From d0c697deaaddbcc0560a1e65e992d618821393c0 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 11:24:57 +0200
Subject: [PATCH] wlan: the performance monitor runs only when it is asked to

The performance monitor runs only while the module parameter
perf_monitor, unset by default, is set or the debug interface forces it.
Each round, every second while a link is up and the screen lit, wakes
the driver and sends the chip two statistics commands. Without the
monitor there is no CPU boost from 100 Mbit/s.
---
 connectivity/wlan/core/gen4m/os/linux/gl_kal.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/connectivity/wlan/core/gen4m/os/linux/gl_kal.c b/connectivity/wlan/core/gen4m/os/linux/gl_kal.c
index 24829f9..6f36f11 100644
--- a/connectivity/wlan/core/gen4m/os/linux/gl_kal.c
+++ b/connectivity/wlan/core/gen4m/os/linux/gl_kal.c
@@ -217,6 +217,10 @@ u_int8_t wlan_perf_monitor_force_enable = TRUE;
 u_int8_t wlan_perf_monitor_force_enable = FALSE;
 #endif
 
+/* Set, the performance monitor may run; it wakes the driver every second. */
+static bool wlan_perf_monitor_wanted;
+module_param_named(perf_monitor, wlan_perf_monitor_wanted, bool, 0644);
+
 static int wlan_fb_notifier_callback(struct notifier_block
 				*self, unsigned long event, void *data);
 
@@ -8073,6 +8077,9 @@ inline int32_t kalPerMonStart(IN struct GLUE_INFO
 
 		return 0;
 
+	if (!wlan_perf_monitor_wanted && !wlan_perf_monitor_force_enable)
+		return 0;
+
 	if (KAL_TEST_BIT(PERF_MON_DISABLE_BIT,
 			 prPerMonitor->ulPerfMonFlag) ||
 	    KAL_TEST_BIT(PERF_MON_RUNNING_BIT,
@@ -8461,7 +8468,8 @@ void kalPerMonHandler(IN struct ADAPTER *prAdapter,
 	if (!wlan_perf_monitor_force_enable &&
 			(wlan_fb_power_down ||
 			prGlueInfo->fgIsInSuspendMode ||
-			!keep_alive))
+			!keep_alive ||
+			!wlan_perf_monitor_wanted))
 		kalPerMonStop(prGlueInfo);
 	else {
 		if (kalCheckTputLoad(prAdapter,
-- 
