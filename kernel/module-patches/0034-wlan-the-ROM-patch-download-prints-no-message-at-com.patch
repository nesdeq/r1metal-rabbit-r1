From 559d9843b373d587fe9f67f234b287942c5dc670 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 20:04:37 +0200
Subject: [PATCH] wlan: the ROM patch download prints no message at compile
 time

wlanDownloadPatch has no #pragma message about SEM-CTRL support, which
prints at every build.
---
 connectivity/wlan/core/gen4m/chips/common/fw_dl.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/connectivity/wlan/core/gen4m/chips/common/fw_dl.c b/connectivity/wlan/core/gen4m/chips/common/fw_dl.c
index 7778615..dd0f542 100644
--- a/connectivity/wlan/core/gen4m/chips/common/fw_dl.c
+++ b/connectivity/wlan/core/gen4m/chips/common/fw_dl.c
@@ -2414,7 +2414,6 @@ uint32_t wlanDownloadPatch(IN struct ADAPTER *prAdapter)
 	}
 
 #if (CFG_ROM_PATCH_NO_SEM_CTRL == 0)
-#pragma message("ROM code supports SEM-CTRL for ROM patch download")
 	if (wlanPatchIsDownloaded(prAdapter)) {
 		kalFirmwareImageUnmapping(prAdapter->prGlueInfo, NULL,
 					  prFwBuffer);
-- 
2.56.0

