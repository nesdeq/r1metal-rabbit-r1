From 56a38c848ffbc4a6d8f0940303df546746e95977 Mon Sep 17 00:00:00 2001
From: r1metal <r1metal@localhost>
Date: Wed, 14 Oct 2026 20:04:37 +0200
Subject: [PATCH] wmt: the radio's systrace marks make no trace_printk users

osal_ftrace_print writes no STP and WMT systrace marks: their
trace_printk makes the kernel print its trace_printk banner at boot and
grow the trace buffer, for marks nothing reads.
---
 connectivity/common/common_main/linux/osal.c | 17 ++---------------
 1 file changed, 2 insertions(+), 15 deletions(-)

diff --git a/connectivity/common/common_main/linux/osal.c b/connectivity/common/common_main/linux/osal.c
index e6db077..bab0a6d 100644
--- a/connectivity/common/common_main/linux/osal.c
+++ b/connectivity/common/common_main/linux/osal.c
@@ -1541,23 +1541,10 @@ VOID osal_op_raise_signal(P_OSAL_OP pOp, INT32 result)
 	}
 }
 
+/* Writes no systrace mark, so the kernel has no trace_printk user. */
 INT32 osal_ftrace_print(const PINT8 str, ...)
 {
-	int ret = 0;
-#ifdef CONFIG_TRACING
-	va_list args;
-	INT8 tempString[DBG_LOG_STR_SIZE];
-
-	if (ftrace_flag) {
-		va_start(args, str);
-		ret = vsnprintf(tempString, DBG_LOG_STR_SIZE, str, args);
-		va_end(args);
-
-		if (ret > 0)
-			trace_printk("%s\n", tempString);
-	}
-#endif
-	return ret;
+	return 0;
 }
 
 INT32 osal_ftrace_print_ctrl(INT32 flag)
-- 
