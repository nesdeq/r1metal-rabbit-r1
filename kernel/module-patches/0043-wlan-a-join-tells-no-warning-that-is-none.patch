+	       params.ssid.ssid, params.ssid.ssid_len, params.action,
 	       (uint8_t) (params.key_mgmt_suite & 0x000000FF),
 	       (uint8_t) ((params.key_mgmt_suite >> 8) & 0x000000FF),
 	       (uint8_t) ((params.key_mgmt_suite >> 16) & 0x000000FF),
