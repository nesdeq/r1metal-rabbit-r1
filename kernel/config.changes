# The debug UARTs, whose console is off, and the drivers of devices this board does not have.
# CONFIG_SERIAL_8250 is not set
# CONFIG_MTK_UART_APDMA is not set
# CONFIG_PRINTK_MTK_UART_CONSOLE is not set
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_CPUFREQ is not set
# CONFIG_ARM_SCMI_CPUFREQ is not set
# CONFIG_COMMON_CLK_SCPI is not set
# CONFIG_COMMON_CLK_XGENE is not set
# CONFIG_PINCTRL_SINGLE is not set
# CONFIG_PINCTRL_MT6397 is not set
# CONFIG_MFD_ACT8945A is not set
# CONFIG_MTK_HSDMA is not set
# CONFIG_CORESIGHT is not set
# CONFIG_MTK_LENS is not set
# CONFIG_MTK_CAMERA_ISP_DPE_SUPPORT is not set
# CONFIG_MTK_CAMERA_ISP_FD_SUPPORT is not set
# CONFIG_MTK_COMBO_GPS is not set
# CONFIG_MTK_GPS_SUPPORT is not set

# Android's generic kernel image selects drivers for modules built elsewhere; the hidden symbols drivers here use stay set.
# CONFIG_GKI_HACKS_TO_FIX is not set
# CONFIG_GKI_HIDDEN_DRM_CONFIGS is not set
# CONFIG_GKI_HIDDEN_CRYPTO_CONFIGS is not set
# CONFIG_GKI_HIDDEN_GPIO_CONFIGS is not set
# CONFIG_GKI_HIDDEN_VIRTUAL_CONFIGS is not set
# CONFIG_GKI_HIDDEN_VIDEOBUF2_CONFIGS is not set
# CONFIG_GKI_HIDDEN_GPU_CONFIGS is not set
CONFIG_GKI_HIDDEN_REGMAP_CONFIGS=y
CONFIG_GKI_HIDDEN_SND_CONFIGS=y
CONFIG_GKI_HIDDEN_SND_SOC_CONFIGS=y
CONFIG_GKI_LEGACY_WEXT_ALLCONFIG=y
CONFIG_GKI_HIDDEN_SOC_PM_CONFIGS=y
CONFIG_GKI_HIDDEN_USB_CONFIGS=y
CONFIG_GKI_HIDDEN_SOC_BUS_CONFIGS=y
CONFIG_GKI_HIDDEN_IRQ_CONFIGS=y

# The GPU, which only closed userspace drives, with the DRM core and the frame pacer that serve it.
# CONFIG_MTK_GPU_SUPPORT is not set
# CONFIG_MTK_FPSGO_V3 is not set
# CONFIG_DRM is not set

# MediaTek's debug and Android services nothing reads: hang detector, eMMC trace, scheduler tracers, ATF log, socinfo, kinfo, the PD log thread.
# CONFIG_MTK_HANG_DETECT is not set
# CONFIG_MTK_HANG_DETECT_DB is not set
# CONFIG_MTK_MMC_DEBUG is not set
# CONFIG_MTK_SCHED_TRACERS is not set
# CONFIG_MTK_ATF_LOGGER is not set
# CONFIG_MTK_SOCINFO is not set
# CONFIG_DEBUG_KINFO is not set
# CONFIG_MTK_MM_DEBUG is not set
# CONFIG_PD_DBG_INFO is not set
