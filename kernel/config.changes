# The release is named after r1metal instead of the commit the tree stands at.
CONFIG_LOCALVERSION="-r1metal"
# CONFIG_LOCALVERSION_AUTO is not set

# These two select about 440 Android options; off, so the lines below can take effect.
# CONFIG_ANDROID_DEFAULT_SETTING is not set
# CONFIG_MTK_ANDROID_DEFAULT_SETTING is not set

# Optimise for speed, and no tracer call at the start of every function.
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_FUNCTION_TRACER is not set
CONFIG_ENABLE_DEFAULT_TRACERS=y

# The kernel is optimised as one program at link time, by ThinLTO.
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y

# The boot image's ramdisk is LZ4, as Rabbit's is; stock unpacked it only because incremental fs selected the decompressor.
CONFIG_RD_LZ4=y

# All eight Cortex-A53 cores report REVIDR_EL1 bit 8, erratum 843419 fixed in silicon, so the linker leaves ADRP alone.
# CONFIG_ARM64_ERRATUM_843419 is not set

# Static keys are patched into the code instead of tested at run time.
CONFIG_JUMP_LABEL=y

# The SoC has 8 cores.
CONFIG_NR_CPUS=8

# Bookkeeping and probes nothing here reads.
# CONFIG_SCHEDSTATS is not set
# CONFIG_PSI is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_BPF_EVENTS is not set

# Packet filtering and connection tracking, whose collector runs twice a second.
# CONFIG_NETFILTER is not set

# Android's interprocess plumbing.
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_ANDROID_BINDERFS is not set
# CONFIG_ASHMEM is not set

# 32 bit programs.
# CONFIG_COMPAT is not set

# The filesystem of the data partition, without transparent compression.
CONFIG_F2FS_FS=y
# CONFIG_F2FS_FS_COMPRESSION is not set

# Devices that exist only inside virtual machines.
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_CRYPTO_DEV_VIRTIO is not set
# CONFIG_VSOCKETS is not set
# CONFIG_VIRT_WIFI is not set

# Everything is built in; the module symbols are set off one by one, since without modules Kconfig would build them in.
# CONFIG_MODULES is not set
# CONFIG_IKHEADERS is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_SERIAL_OF_PLATFORM is not set
# CONFIG_BATTERY_MT6359 is not set
# CONFIG_SND_SOC_MT6357_ACCDET is not set
# CONFIG_SND_SOC_MT6359_ACCDET is not set
# CONFIG_USB_DUMMY_HCD is not set
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SDHCI_PLTFM is not set
# CONFIG_MMSTAT_TRACER is not set

# Hardening, mitigations and access control r1metal does not run on.
# CONFIG_AUDIT is not set
# CONFIG_SECCOMP is not set
# CONFIG_SECCOMP_FILTER is not set
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_HARDEN_EL2_VECTORS is not set
# CONFIG_ARM64_SSBD is not set
# CONFIG_ARM64_SW_TTBR0_PAN is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_STACKPROTECTOR_STRONG is not set
# CONFIG_VMAP_STACK is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_HARDENED_USERCOPY is not set
# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_NETWORK is not set
# CONFIG_SECURITY_PERF_EVENTS_RESTRICT is not set
# CONFIG_INTEGRITY is not set
# CONFIG_NETWORK_SECMARK is not set
# CONFIG_KEYS is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_DATA_VERIFICATION is not set
# CONFIG_ASYMMETRIC_KEY_TYPE is not set
# CONFIG_X509_CERTIFICATE_PARSER is not set
# CONFIG_PKCS7_MESSAGE_PARSER is not set
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set

# /dev/mem, to read the GIC's trigger setup and the SPM's power status, which no driver shows.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# Device mapper, verity, encryption, overlays and quotas; r1metal mounts f2fs, fuse, tmpfs, configfs, pstore and tracefs only.
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_DM_CRYPT is not set
# CONFIG_DM_DEFAULT_KEY is not set
# CONFIG_DM_SNAPSHOT is not set
# CONFIG_DM_VERITY is not set
# CONFIG_DM_BOW is not set
# CONFIG_DM_USER is not set
# CONFIG_FS_VERITY is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_BLK_INLINE_ENCRYPTION is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_INCREMENTAL_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_F2FS_FS_POSIX_ACL is not set
# CONFIG_QUOTA is not set
# CONFIG_QUOTACTL is not set
# CONFIG_QFMT_V2 is not set
# CONFIG_UNICODE is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_NLS_CODEPAGE_737 is not set
# CONFIG_NLS_CODEPAGE_775 is not set
# CONFIG_NLS_CODEPAGE_850 is not set
# CONFIG_NLS_CODEPAGE_852 is not set
# CONFIG_NLS_CODEPAGE_855 is not set
# CONFIG_NLS_CODEPAGE_857 is not set
# CONFIG_NLS_CODEPAGE_860 is not set
# CONFIG_NLS_CODEPAGE_861 is not set
