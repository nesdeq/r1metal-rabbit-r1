# CONFIG_DUMMY is not set
# CONFIG_NET_SCHED is not set
# CONFIG_IP_SCTP is not set
# CONFIG_TIPC is not set
# CONFIG_MAC80211 is not set

# nl80211's test mode, through which Android's supplicant sent MediaTek's driver commands; r1metal sends none.
# CONFIG_NL80211_TESTMODE is not set

# Crypto nothing kept asks for by name; what Bluetooth, pstore, TCP Fast Open and the RPMB bridge need stays selected or set.
# CONFIG_CRYPTO_USER is not set
# CONFIG_CRYPTO_ARC4 is not set
# CONFIG_CRYPTO_AUTHENC is not set
# CONFIG_CRYPTO_BLOWFISH is not set
# CONFIG_CRYPTO_CBC is not set
